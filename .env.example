# 이 파일을 복사해 .env를 만들고 값을 채우세요. .env는 커밋하지 않습니다.
# 설명은 값 줄 위에 둡니다. docker compose는 `이름=   # 설명`처럼 값이 빈 줄의 # 뒤를 값으로 읽습니다.
# 변수 이름은 초안이며 Phase 2~3에서 확정합니다.

# ── 데이터베이스 ──
POSTGRES_DB=cineloca
POSTGRES_USER=cineloca
POSTGRES_PASSWORD=
DATABASE_URL=

# ── AI (SDD 2.4: 팀원 PC는 gemini, 팀 서버는 ollama) ──
AI_PROVIDER=gemini           # ollama: 로컬 주 + Gemini 보조 / gemini: Gemini만 / none: AI 끔(강등 확인용)
# Google AI Studio 키 (무료 등급, 일일 한도 작음)
GEMINI_API_KEY=
# 비우면 gemini-3.5-flash
GEMINI_MODEL=
# 비우면 20. AI Studio의 무료 등급 일일 요청 한도(70% 경고, 100%면 건너뜀)
GEMINI_DAILY_LIMIT=
# 예: http://ollama:11434 (팀 서버). 비우면 Ollama·임베딩 안 씀
OLLAMA_BASE_URL=
# 비우면 qwen3:8b
OLLAMA_MODEL=
# 비우면 bge-m3 (1024차원)
OLLAMA_EMBED_MODEL=

# ── 외부 데이터 API (배치) ──
# 공공데이터포털 (부산영상위원회, 교통공사, TourAPI)
DATA_GO_KR_SERVICE_KEY=
# 한국영상자료원 KMDb
KMDB_SERVICE_KEY=
# 행정안전부 주소 검색 API
JUSO_SEARCH_API_KEY=
# 행정안전부 좌표 제공 API
JUSO_COORD_API_KEY=
# 카카오 로컬 REST 키(배치 전용). GEOCODE_KAKAO_KEYWORD=true일 때만 씀. 응답은 저장하지 않음
KAKAO_REST_API_KEY=
GEOCODE_KAKAO_KEYWORD=false  # true면 주소 없는·동까지만 있는 촬영지를 카카오 키워드 검색으로 찾음(#25). 약관 확인 전까지 false(ADR-006)
# KMDB_SERVICE_KEY가 없을 때 배치 매칭에 쓸 KMDb '영화기본정보' CSV 경로(선택)
KMDB_CSV_PATH=
SYNC_INTERVAL_DAYS=7          # 정기 동기화 주기(일, FR-616). 0이면 끔. 배치 감시(--watch)와 관리자 화면이 같은 값을 씀

# ── 프론트엔드 ──
# 카카오 JavaScript 키 (등록 도메인에서만 동작). 비우면 OpenStreetMap으로 대체 표시
VITE_KAKAO_JS_KEY=
VITE_API_MOCK=true           # npm run dev용. true: 목업 API로 화면만 동작, false: /api를 백엔드(localhost:8000)로 보냄. docker compose의 web은 항상 false

# ── 로그 (NFR-005) ──
LOG_LEVEL=INFO               # 앱 로그 수준. 콘솔이 시끄러우면 WARNING
# 요청 로그 폴더(7일 보관). 비우면 파일로 남기지 않음. Docker는 /app/logs 고정
LOG_DIR=

# ── 보안 ──
# 관리자 비밀번호 해시 (FR-615)
#   만들기: backend 폴더에서 python scripts/admin_password_hash.py → 나온 한 줄을 여기에. 비우면 관리 API만 503
ADMIN_PASSWORD_HASH=
# 스탬프·배지 HMAC 서명 키 (ADR-009)
#   32자 이상. 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   바꾸면 이미 발급한 스탬프·배지가 모두 무효가 됩니다
STAMP_SIGNING_KEY=
