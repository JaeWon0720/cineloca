# 이 파일을 복사해 .env를 만들고 값을 채우세요. .env는 커밋하지 않습니다.
# 변수 이름은 초안이며 Phase 2~3에서 확정합니다.

# ── 데이터베이스 ──
POSTGRES_DB=cineloca
POSTGRES_USER=cineloca
POSTGRES_PASSWORD=
DATABASE_URL=

# ── AI (SDD 2.4: 팀원 PC는 gemini, 팀 서버는 ollama) ──
AI_PROVIDER=gemini
GEMINI_API_KEY=
OLLAMA_BASE_URL=

# ── 외부 데이터 API (배치) ──
DATA_GO_KR_SERVICE_KEY=      # 공공데이터포털 (부산영상위원회, 교통공사, TourAPI)
KMDB_SERVICE_KEY=            # 한국영상자료원 KMDb
JUSO_SEARCH_API_KEY=         # 행정안전부 주소 검색 API
JUSO_COORD_API_KEY=          # 행정안전부 좌표 제공 API

# ── 프론트엔드 ──
VITE_KAKAO_JS_KEY=           # 카카오 JavaScript 키 (등록 도메인에서만 동작)

# ── 보안 ──
ADMIN_PASSWORD_HASH=         # 관리자 비밀번호 해시 (FR-615)
STAMP_SIGNING_KEY=           # 스탬프·배지 HMAC 서명 키 (ADR-009)